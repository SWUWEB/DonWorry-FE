# 이 파일을 .env.local 로 복사한 뒤 값을 채워주세요. (.env.local 은 커밋되지 않습니다)

# 백엔드 API 주소. 프로덕션 빌드에서 비어 있으면 빌드가 실패합니다.
# 개발 서버는 이 값을 Vite 프록시 대상으로 사용합니다.
VITE_API_BASE_URL=

# 카카오 개발자 콘솔(https://developers.kakao.com) > 내 애플리케이션 > 앱 키의 REST API 키를 넣어주세요.
VITE_KAKAO_CLIENT_ID=

# 카카오 콘솔 > 카카오 로그인 > Redirect URI에 아래와 동일한 값을 등록해야 합니다.
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback
